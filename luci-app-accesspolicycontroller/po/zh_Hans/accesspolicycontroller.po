msgid "Use English letters, numbers, and hyphens only."
msgstr "仅可使用英文字母、数字和连字符。"

msgid "A rate limit policy with this name already exists."
msgstr "已存在使用此名称的限速策略。"

msgid "Enter a positive number."
msgstr "请输入正数。"

msgid "Name"
msgstr "名称"

msgid "MAC address"
msgstr "MAC 地址"

msgid "IPv4 address"
msgstr "IPv4 地址"

msgid "IPv6 address"
msgstr "IPv6 地址"

msgid "Rate limit policy"
msgstr "限速策略"

msgid "None"
msgstr "无"

msgid "Comment"
msgstr "备注"

msgid "unit"
msgstr "单位"

msgid "Access Policy Controller"
msgstr "访问策略控制器"

msgid "Control internet access on selected internal interfaces with whitelist or blacklist rules. Whitelisted devices can optionally receive bandwidth limits."
msgstr "通过白名单或黑名单规则控制所选内部接口的互联网访问。可为白名单设备设置带宽限制。"

msgid "Overview"
msgstr "概览"

msgid "Enable"
msgstr "启用"

msgid "Mode"
msgstr "模式"

msgid "Chain priority"
msgstr "链优先级"

msgid "Controls when this access policy chain runs relative to other firewall chains. Lower values run first."
msgstr "控制此访问策略链相对于其他防火墙链的执行顺序。数值越小，优先级越高。"

msgid "Highest priority"
msgstr "最高优先级"

msgid "High priority"
msgstr "高优先级"

msgid "Normal priority"
msgstr "普通优先级"

msgid "Low priority"
msgstr "低优先级"

msgid "Whitelist mode"
msgstr "白名单模式"

msgid "Blacklist mode"
msgstr "黑名单模式"

msgid "Block router local access"
msgstr "拦截路由器本地通信"

msgid "When enabled, whitelist mode permits only whitelisted devices to access the router when at least one valid whitelist entry exists; otherwise router access remains available to prevent lockout. Blacklist mode also blocks blacklisted devices from accessing it."
msgstr "启用后，白名单模式仅会在至少存在一个有效白名单条目时，仅允许白名单设备访问路由器；否则为防止锁死管理访问，将保持路由器可访问。黑名单模式会同时禁止黑名单设备访问路由器。"

msgid "Application interfaces"
msgstr "应用接口"

msgid "Select the internal interfaces where access policies apply. You can select more than one interface. Do not select WAN interfaces."
msgstr "选择要应用访问策略的内部接口，可选择多个接口。请勿选择 WAN 接口。"

msgid "Rate limit policies"
msgstr "限速策略"

msgid "Upload limit"
msgstr "上传限速"

msgid "Download limit"
msgstr "下载限速"

msgid "Whitelist"
msgstr "白名单"

msgid "Blacklist"
msgstr "黑名单"

msgid "Whitelist mode blocks devices not on the whitelist. Blacklist mode blocks only devices on the blacklist."
msgstr "白名单模式会阻止不在白名单中的设备。黑名单模式只阻止黑名单中的设备。"
