#!/bin/sh

PATH=/usr/sbin:/usr/bin:/sbin:/bin
TABLE=accesspolicycontroller
STATE_FILE=/var/run/accesspolicycontroller.devices
INGRESS_FILTER_PRIORITY=49152

. /lib/functions.sh
. /lib/functions/network.sh

valid_address() {
	local family="$1"
	local expression="$2"
	local address="$3"
	printf 'table %s apc_address_check {\n\tchain forward {\n\t\t%s saddr %s accept\n\t}\n}\n' "$family" "$expression" "$address" | nft -c -f - >/dev/null 2>&1
}

valid_ipv4() {
	echo "$1" | grep -Eq '^[0-9.]+$' && valid_address inet ip "$1"
}

valid_ipv6() {
	echo "$1" | grep -Eq '^[0-9A-Fa-f:.]+$' && valid_address inet ip6 "$1"
}

valid_mac() {
	echo "$1" | grep -Eqi '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'
}

valid_rate() {
	echo "$1" | grep -Eq '^[0-9]+(\.[0-9]+)?$' && awk -v value="$1" 'BEGIN { exit !(value > 0) }'
}

valid_chain_priority() {
	echo "$1" | grep -Eq '^-?[0-9]+$' && [ "$1" -ge -300 ] && [ "$1" -le 300 ]
}

rate_to_bits() {
	local multiplier
	case "$2" in
		B/s) multiplier=8 ;;
		KB/s) multiplier=8192 ;;
		MB/s) multiplier=8388608 ;;
		GB/s) multiplier=8589934592 ;;
		*) return 1 ;;
	esac
	awk -v value="$1" -v multiplier="$multiplier" 'BEGIN { printf "%.0f", value * multiplier }'
}

resolve_device() {
	local network="$1"
	local device
	network_get_device device "$network"
	[ -n "$device" ] || device="$(uci -q get "network.$network.device")"
	device="${device%% *}"
	echo "$device"
}

emit_acl_rule() {
	local section="$1"
	local mode="$2"
	local ipv4 ipv6 mac verdict prefix
	config_get ipv4 "$section" ipv4
	config_get ipv6 "$section" ipv6
	config_get mac "$section" mac
	[ "$mode" = blacklist ] && verdict=drop || verdict=accept
	valid_mac "$mac" && prefix="ether saddr $mac "
	if valid_ipv4 "$ipv4"; then
		printf '\t\t%sip saddr %s counter %s\n' "$prefix" "$ipv4" "$verdict"
	fi
	if valid_ipv6 "$ipv6"; then
		printf '\t\t%sip6 saddr %s counter %s\n' "$prefix" "$ipv6" "$verdict"
	fi
	if [ -z "$ipv4$ipv6" ] && valid_mac "$mac"; then
		printf '\t\tether saddr %s counter %s\n' "$mac" "$verdict"
	fi
}

build_nft_rules() {
	local mode="$1"
	local chain_priority="$2"
	local device
	shift
	shift
	printf 'table inet %s {\n' "$TABLE"
	printf '\tchain forward {\n'
	printf '\t\ttype filter hook forward priority %s; policy accept;\n' "$chain_priority"
	for device in "$@"; do
		printf '\t\tiifname "%s" jump lan_policy\n' "$device"
	done
	printf '\t}\n\tchain lan_policy {\n'
	if [ "$mode" = whitelist ]; then
		config_foreach emit_acl_rule whitelist "$mode"
		printf '\t\tcounter drop\n'
	elif [ "$mode" = hybrid ]; then
		config_foreach emit_acl_rule blacklist blacklist
		config_foreach emit_acl_rule whitelist whitelist
	else
		config_foreach emit_acl_rule blacklist blacklist
	fi
	printf '\t}\n}\n'
}

replace_nft_rules() {
	nft delete table inet "$TABLE" 2>/dev/null || true
	build_nft_rules "$@"
}

lookup_policy() {
	local section="$1"
	local wanted="$2"
	local name
	config_get name "$section" name
	[ "$name" = "$wanted" ] || return 0
	config_get POLICY_UPLOAD "$section" upload
	config_get POLICY_UPLOAD_UNIT "$section" upload_unit
	config_get POLICY_DOWNLOAD "$section" download
	config_get POLICY_DOWNLOAD_UNIT "$section" download_unit
}

find_policy() {
	POLICY_UPLOAD=
	POLICY_UPLOAD_UNIT=
	POLICY_DOWNLOAD=
	POLICY_DOWNLOAD_UNIT=
	config_foreach lookup_policy policy "$1"
	valid_rate "$POLICY_UPLOAD" && valid_rate "$POLICY_DOWNLOAD"
}

add_tc_filters() {
	local device="$1"
	local ifb_device="$2"
	local class="$3"
	local priority="$4"
	local ipv4="$5"
	local ipv6="$6"
	local mac="$7"
	local matched=0
	if valid_ipv4 "$ipv4"; then
		matched=1
		tc filter add dev "$device" parent 1:0 protocol ip prio "$priority" u32 match ip dst "$ipv4" flowid 1:"$class" || return 1
		tc filter add dev "$ifb_device" parent 2:0 protocol ip prio "$priority" u32 match ip src "$ipv4" flowid 2:"$class" || return 1
	fi
	if valid_ipv6 "$ipv6"; then
		matched=1
		tc filter add dev "$device" parent 1:0 protocol ipv6 prio "$priority" u32 match ip6 dst "$ipv6" flowid 1:"$class" || return 1
		tc filter add dev "$ifb_device" parent 2:0 protocol ipv6 prio "$priority" u32 match ip6 src "$ipv6" flowid 2:"$class" || return 1
	fi
	if valid_mac "$mac"; then
		matched=1
		tc filter add dev "$device" parent 1:0 protocol all prio "$priority" u32 match ether dst "$mac" flowid 1:"$class" || return 1
		tc filter add dev "$ifb_device" parent 2:0 protocol all prio "$priority" u32 match ether src "$mac" flowid 2:"$class" || return 1
	fi
	[ "$matched" = 1 ]
}

shape_whitelist_entry() {
	local section="$1"
	local policy ipv4 ipv6 mac upload_bits download_bits
	config_get policy "$section" policy
	[ -n "$policy" ] && find_policy "$policy" || return 0
	config_get ipv4 "$section" ipv4
	config_get ipv6 "$section" ipv6
	config_get mac "$section" mac
	if ! valid_ipv4 "$ipv4" && ! valid_ipv6 "$ipv6" && ! valid_mac "$mac"; then
		logger -t "$TABLE" "skipping rate limit entry without a valid address: $section"
		return 0
	fi
	upload_bits="$(rate_to_bits "$POLICY_UPLOAD" "$POLICY_UPLOAD_UNIT")" || return 0
	download_bits="$(rate_to_bits "$POLICY_DOWNLOAD" "$POLICY_DOWNLOAD_UNIT")" || return 0
	TC_CLASS=$((TC_CLASS + 1))
	[ "$TC_CLASS" -le 4095 ] || return 0
	tc class replace dev "$CURRENT_DEVICE" parent 1:1 classid 1:"$TC_CLASS" htb rate "${download_bits}bit" ceil "${download_bits}bit" || TC_FAILED=1
	tc class replace dev "$CURRENT_IFB_DEVICE" parent 2:1 classid 2:"$TC_CLASS" htb rate "${upload_bits}bit" ceil "${upload_bits}bit" || TC_FAILED=1
	[ "$TC_FAILED" = 0 ] && add_tc_filters "$CURRENT_DEVICE" "$CURRENT_IFB_DEVICE" "$TC_CLASS" "$TC_CLASS" "$ipv4" "$ipv6" "$mac" || TC_FAILED=1
}

cleanup_tc() {
	local device="$1"
	local ifb_device="$2"
	if tc qdisc show dev "$device" 2>/dev/null | grep -q 'qdisc clsact '; then
		tc filter del dev "$device" ingress prio "$INGRESS_FILTER_PRIORITY" u32 2>/dev/null || true
	else
		tc filter del dev "$device" parent ffff: prio "$INGRESS_FILTER_PRIORITY" u32 2>/dev/null || true
	fi
	if tc qdisc show dev "$device" 2>/dev/null | grep -q 'qdisc htb 1: root'; then
		tc qdisc del dev "$device" root 2>/dev/null || true
	fi
	ip link set dev "$ifb_device" down 2>/dev/null || true
	ip link del dev "$ifb_device" 2>/dev/null || true
}

setup_tc() {
	local device="$1"
	local ifb_device="$2"
	local root_qdisc ingress_filter
	modprobe cls_u32 2>/dev/null || true
	modprobe act_mirred 2>/dev/null || true
	modprobe sch_ingress 2>/dev/null || true
	root_qdisc="$(tc qdisc show dev "$device" 2>/dev/null | sed -n '1p')"
	if [ -n "$root_qdisc" ] && ! echo "$root_qdisc" | grep -q 'qdisc noqueue 0: root'; then
		logger -t "$TABLE" "replacing existing root qdisc on $device"
	fi
	ip link add name "$ifb_device" type ifb 2>/dev/null || true
	ip link set dev "$ifb_device" up || return 1
	tc qdisc replace dev "$device" root handle 1: htb default 1 || { cleanup_tc "$device" "$ifb_device"; return 1; }
	tc class replace dev "$device" parent 1: classid 1:1 htb rate 1000gbit ceil 1000gbit || { cleanup_tc "$device" "$ifb_device"; return 1; }
	if ! tc qdisc show dev "$device" 2>/dev/null | grep -Eq 'qdisc (clsact|ingress) '; then
		tc qdisc add dev "$device" clsact 2>/dev/null || tc qdisc add dev "$device" ingress || { cleanup_tc "$device" "$ifb_device"; return 1; }
	fi
	if tc qdisc show dev "$device" 2>/dev/null | grep -q 'qdisc clsact '; then
		ingress_filter="ingress"
	else
		ingress_filter="parent ffff:"
	fi
	tc filter del dev "$device" $ingress_filter prio "$INGRESS_FILTER_PRIORITY" u32 2>/dev/null || true
	tc filter add dev "$device" $ingress_filter prio "$INGRESS_FILTER_PRIORITY" u32 match u32 0 0 flowid 1:1 action mirred egress redirect dev "$ifb_device" || { cleanup_tc "$device" "$ifb_device"; return 1; }
	tc qdisc replace dev "$ifb_device" root handle 2: htb default 1 || { cleanup_tc "$device" "$ifb_device"; return 1; }
	tc class replace dev "$ifb_device" parent 2: classid 2:1 htb rate 1000gbit ceil 1000gbit || { cleanup_tc "$device" "$ifb_device"; return 1; }
	CURRENT_DEVICE="$device"
	CURRENT_IFB_DEVICE="$ifb_device"
	TC_CLASS=1
	TC_FAILED=0
	config_foreach shape_whitelist_entry whitelist
	if [ "$TC_FAILED" != 0 ]; then
		logger -t "$TABLE" "failed to apply bandwidth limits"
		cleanup_tc "$device" "$ifb_device"
		return 1
	fi
	return 0
}

cleanup_saved_tc() {
	local device ifb_device
	[ -f "$STATE_FILE" ] || return 0
	while read -r device ifb_device; do
		[ -n "$device" ] && [ -n "$ifb_device" ] && cleanup_tc "$device" "$ifb_device"
	done < "$STATE_FILE"
	rm -f "$STATE_FILE"
}

stop_all() {
	cleanup_saved_tc
	nft delete table inet "$TABLE" 2>/dev/null || true
}

apply() {
	local enabled mode chain_priority networks network device devices ifb_device index
	config_load accesspolicycontroller
	config_get enabled main enabled 0
	config_get chain_priority main chain_priority -300
	config_get mode main mode whitelist
	config_get networks main network lan
	if [ "$enabled" != 1 ]; then
		stop_all
		return 0
	fi
	if [ "$mode" != whitelist ] && [ "$mode" != blacklist ] && [ "$mode" != hybrid ]; then
		logger -t "$TABLE" "invalid mode: $mode"
		return 1
	fi
	if ! valid_chain_priority "$chain_priority"; then
		logger -t "$TABLE" "invalid chain priority: $chain_priority"
		return 1
	fi
	devices=
	for network in $networks; do
		device="$(resolve_device "$network")"
		if [ -z "$device" ]; then
			logger -t "$TABLE" "cannot resolve network device for $network"
			return 1
		fi
		case " $devices " in
			*" $device "*) ;;
			*) devices="${devices:+$devices }$device" ;;
		esac
	done
	if [ -z "$devices" ]; then
		logger -t "$TABLE" "no application interfaces configured"
		return 1
	fi
	cleanup_saved_tc
	if ! replace_nft_rules "$mode" "$chain_priority" $devices | nft -f -; then
		logger -t "$TABLE" "failed to apply nftables rules"
		return 1
	fi
	if [ "$mode" = whitelist ] || [ "$mode" = hybrid ]; then
		: > "$STATE_FILE"
		index=0
		for device in $devices; do
			ifb_device="apcifb$index"
			if ! setup_tc "$device" "$ifb_device"; then
				cleanup_saved_tc
				return 1
			fi
			printf '%s %s\n' "$device" "$ifb_device" >> "$STATE_FILE"
			index=$((index + 1))
		done
	fi
}

case "$1" in
	apply|reload|restart) apply ;;
	stop) stop_all ;;
	*) echo "Usage: $0 {apply|reload|restart|stop}" >&2; exit 2 ;;
esac